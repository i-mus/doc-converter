{
  "name": "doc-converter",
  "displayName": "Doc Converter — Markdown to Word & Images to PDF",
  "description": "Convert Markdown to Word (.docx) and images to PDF, right from the editor. 100% local — no upload, no sign-up, no account. Free and open source.",
  "version": "0.1.3",
  "publisher": "i-mus",
  "license": "MIT",
  "author": "i-mus (https://github.com/i-mus)",
  "repository": {
    "type": "git",
    "url": "https://github.com/i-mus/doc-converter",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/i-mus/doc-converter/issues"
  },
  "homepage": "https://doc-converter-4vgm.onrender.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown to word",
    "markdown to docx",
    "md to docx",
    "docx",
    "word document",
    "image to pdf",
    "images to pdf",
    "jpg to pdf",
    "png to pdf",
    "pdf converter",
    "document converter",
    "offline",
    "privacy",
    "no upload",
    "export"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#b4552d",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docConverter.mdToDocx",
        "title": "Convert Markdown to Word (.docx)",
        "category": "Doc Converter"
      },
      {
        "command": "docConverter.imagesToPdf",
        "title": "Combine Images into PDF",
        "category": "Doc Converter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docConverter.mdToDocx",
          "when": "resourceExtname =~ /\\.(md|markdown)$/i",
          "group": "5_export@1"
        },
        {
          "command": "docConverter.imagesToPdf",
          "when": "resourceExtname =~ /\\.(png|jpe?g)$/i",
          "group": "5_export@2"
        }
      ],
      "editor/title": [
        {
          "command": "docConverter.mdToDocx",
          "when": "resourceExtname =~ /\\.(md|markdown)$/i",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "docConverter.mdToDocx",
          "when": "true"
        },
        {
          "command": "docConverter.imagesToPdf",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Doc Converter",
      "properties": {
        "docConverter.openAfterConvert": {
          "type": "boolean",
          "default": true,
          "description": "After converting, offer to reveal or open the new file."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "icon": "node scripts/make-icon.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.0.0",
    "marked": "^12.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "mocha": "^10.8.2",
    "sharp": "^0.33.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
