{
  "name": "doc-converter",
  "displayName": "Doc Converter — Markdown to Word & Images to PDF",
  "description": "Convert Markdown to .docx and images to PDF, right in the editor. Runs locally, works offline, nothing is uploaded.",
  "version": "0.1.0",
  "publisher": "i-mus",
  "license": "MIT",
  "author": "i-mus (https://github.com/i-mus)",
  "repository": {
    "type": "git",
    "url": "https://github.com/i-mus/doc-converter",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/i-mus/doc-converter/issues"
  },
  "homepage": "https://doc-converter-4vgm.onrender.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "docx",
    "word",
    "pdf",
    "image to pdf",
    "convert",
    "export"
  ],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docConverter.mdToDocx",
        "title": "Convert Markdown to Word (.docx)",
        "category": "Doc Converter"
      },
      {
        "command": "docConverter.imagesToPdf",
        "title": "Combine Images into PDF",
        "category": "Doc Converter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docConverter.mdToDocx",
          "when": "resourceExtname =~ /\\.(md|markdown)$/i",
          "group": "5_export@1"
        },
        {
          "command": "docConverter.imagesToPdf",
          "when": "resourceExtname =~ /\\.(png|jpe?g)$/i",
          "group": "5_export@2"
        }
      ],
      "editor/title": [
        {
          "command": "docConverter.mdToDocx",
          "when": "resourceExtname =~ /\\.(md|markdown)$/i",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "docConverter.mdToDocx",
          "when": "true"
        },
        {
          "command": "docConverter.imagesToPdf",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Doc Converter",
      "properties": {
        "docConverter.openAfterConvert": {
          "type": "boolean",
          "default": true,
          "description": "After converting, offer to reveal or open the new file."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "icon": "node scripts/make-icon.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.0.0",
    "marked": "^12.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "sharp": "^0.33.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
